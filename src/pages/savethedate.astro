    <style>
      @font-face {
        font-family: "miama";
        src: url('/fonts/miama.otf') format('opentype');
      }
      @font-face {
        font-family: "georgia";
        src: url('/fonts/georgia.ttf') format('truetype');
      }

      body {
        margin: 0;
        width: 100%;
        height: 100%;
        min-height: 100dvh;
        background: linear-gradient(#efe6df, #c9a990);
        box-sizing: border-box;
      }
      main {
        display: flex;
        align-items: center;
        justify-content: space-around;
        padding: 1rem 2rem 0;
        & .photo-frame {
          width: 25rem;
          background: #fafafa;
          padding: 1rem 1rem 0;
          box-sizing: border-box;
          transform: rotate(-11deg);
          box-shadow: 0 0 0.5rem #0e0e0e40;
          & .photo {
            width: 100%;
            background: #d9d9d9;
            padding: 1rem;
            box-sizing: border-box;
            display: grid;
            place-content: center;
            & img {
              width: 20rem;
            }
          }
          p {
            text-align: center;
            font-family: "miama";
            font-size: 4rem;
            margin-block: 0;
            -webkit-text-stroke: 0.5px #000;
          }
        }
        & #logo {
          width: 11rem;
          z-index: 1;
          margin-top: -5rem;
          margin-left: -2rem;
          position: relative;
          opacity: 0.85;
        }
        & .info {
          width: 55%;
          display: flex;
          flex-direction: column;
          justify-content: space-between;
          & h1 {
            font-family: "miama";
            font-size: 4rem;
            font-weight: 400;
            text-align: center;
            margin-block: 0;
            -webkit-text-stroke: 1px #000;
            & span {
              font-size: 3rem;
            }
          }
          & #wedding {
            font-family: "Miama";
            font-size: 3rem;
            font-weight: 400;
            text-align: center;
            margin-block: 0;
            -webkit-text-stroke: 1px #000;
          }
          & #date {
            font-family: "georgia";
            font-size: 1.5rem;
            font-weight: 400;
            text-align: center;
            margin-block: 0;
            margin: 0.5rem 0 1rem;
            & span {
              font-size: 1.75rem;
            }
          }
        }
        & .countdown {
          display: flex;
          flex-wrap: wrap;
          justify-content: center;
          margin: 0.5rem 0 1.5rem;
          & span {
            width: 3.25rem;
            aspect-ratio: 1;
            background: #d9d9d9;
            display: inline-flex;
            justify-content: center;
            align-items: center;
            font-family: "georgia";
            font-size: 2rem;
            box-sizing: border-box;
            border: 0.125rem solid #fafafa;
            border-bottom-width: 1rem;
            box-shadow: 0 0 0.125rem #0e0e0e40;
            &::before {
              content: "";
              font-size: 1.25rem;
              font-family: "miama";
              position: absolute;
              top: 85%;
            }
            &#days {
              transform: rotate(10deg);
              &::before {
                content: "días";
              }
            }
            &#hours {
              transform: rotate(-6deg);
              &::before {
                content: "horas";
              }
            }
            &#minutes {
              transform: rotate(-15deg);
              &::before {
                content: "minutos";
              }
            }
            &#seconds {
              transform: rotate(8deg);
              &::before {
                content: "segundos";
              }
            }
          }
        }
        p {
          font-family: "georgia";
          font-size: 1rem;
          font-weight: 400;
          text-align: center;
          margin-block: 0;
        }
        & .calendars {
          display: flex;
          justify-content: space-between;
          align-items: center;
          gap: 4rem;
          margin: 0.5rem 0;
          & a {
            font-family: "georgia";
            font-size: 0.75rem;
            text-decoration: none;
            padding: 0.25rem 0.5rem;
            border-radius: 2rem;
            color: #000;
            background: #fafafa;
            text-align: center;
            width: 45%;
          }
        }
        & .locations {
          display: flex;
          justify-content: space-between;
          gap: 2rem;
          align-items: center;
          & .card {
            box-sizing: border-box;
            padding: 0.5rem 0.75rem;
            background: #fafafa;
            border-radius: 1rem;
            text-align: center;
            width: 45%;
            p {
              font-family: "georgia";
              font-size: 0.75rem;
              font-weight: 500;
              margin-block: 0;
              &#title {
                font-size: 1.25rem;
                margin-bottom: 0.5rem;
