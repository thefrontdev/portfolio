            }
            img {
              width: 8rem;
              aspect-ratio: 1;
            }
            & .links {
              display: flex;
              justify-content: center;
              align-items: center;
              margin-top: 0.5rem;
              a {
                font-family: "georgia";
                font-size: 0.75rem;
                text-decoration: none;
                padding: 0.25rem 0.5rem;
                border-radius: 2rem;
                color: #000;
                background: #efe6df;
                text-align: center;
                width: 100%;
                padding: 0.25rem 0.5rem;
              }
            }
